# Única chave privada usada pelo backend atual. Cadastre na Vercel em Preview e Production.
# Consulte CONFIGURACAO_APIS.md. Nunca registre o valor real no GitHub.
GEMINI_API_KEY=

# Opcional: usa gemini-3.5-flash-lite caso este valor não seja informado.
GEMINI_MODEL=

# O gerador local funciona sem credenciais. Estas variáveis permitem apontar para outro projeto Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Valores públicos usados somente pelo cliente Supabase Auth no navegador.
# Não use service_role, GEMINI_API_KEY ou qualquer segredo em variáveis VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
